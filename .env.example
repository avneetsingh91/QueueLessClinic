# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
# These values are public identifiers, not secrets. Access is controlled by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the public queue base URL used for QR codes.
# Default: window.location.origin
VITE_PUBLIC_QUEUE_BASE_URL=
